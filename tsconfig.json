{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@dataset/summary": [
        "./src/data/worlds.json"
      ],
      "@dataset/drafts": [
        "./src/data/worlds-2026-drafts.json"
      ],
      "@dataset/builds": [
        "./src/data/worlds-2026-builds.json"
      ],
      "@dataset/build-assets": [
        "./src/data/worlds-2026-build-assets.json"
      ],
      "@dataset/build-timeline": [
        "./src/data/worlds-2026-build-timeline.json"
      ]
    }
  },
  "include": [
    "src"
  ]
}
