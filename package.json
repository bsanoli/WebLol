{
  "name": "weblol",
  "version": "1.0.0",
  "description": "Painel do time: estatísticas do Worlds 2026, planejador de comps e draft, mapa tático e conhecimento (objetivos e controle de wave).",
  "scripts": {
    "test": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/build-icons.mjs",
    "build": "npm run check && vite build && vite build --mode soloq",
    "prebuild": "node scripts/build-icons.mjs",
    "pages:prepare": "npm run build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run typecheck",
    "dev:soloq": "vite --host 127.0.0.1 --mode soloq"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsanoli/WebLol.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/bsanoli/WebLol/issues"
  },
  "homepage": "https://github.com/bsanoli/WebLol#readme",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.14",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@untitledui/icons": "0.0.23",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "private": true
}
