{
  "name": "weblol",
  "version": "1.0.0",
  "description": "Painel do time: estatísticas do Worlds 2026, planejador de comps e draft, mapa tático e conhecimento (objetivos e controle de wave).",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/build-icons.mjs",
    "dev:soloq": "vite --host 127.0.0.1 --mode soloq",
    "build": "npm run check && vite build && vite build --mode soloq",
    "prebuild": "node scripts/build-icons.mjs",
    "pages:prepare": "npm run build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:fsd": "steiger ./src --fail-on-warnings",
    "typecheck": "tsc --noEmit",
    "lint:types": "oxlint --type-aware src tests tests-rules scripts",
    "knip": "knip",
    "size": "size-limit",
    "analyze": "vite build --mode analyze",
    "check": "npm run check:architecture && npm run check:fsd && npm run typecheck && npm run lint:types",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-weblol \"vitest run --config vitest.rules.config.ts\"",
    "verify": "npm run lint && npm run check && npm run knip && npm run test:unit",
    "prepare": "lefthook install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsanoli/WebLol.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/bsanoli/WebLol/issues"
  },
  "homepage": "https://github.com/bsanoli/WebLol#readme",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "@ui-sdk/core": "^0.1.0-beta.13",
    "@ui-sdk/react": "^0.1.0-beta.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "^7.29.14",
    "@biomejs/biome": "2.6.8",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@untitledui/icons": "0.0.23",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "lefthook": "2.2.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rollup-plugin-visualizer": "^7.1.3",
    "size-limit": "^14.3.0",
    "steiger": "0.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "5.1.1"
  },
  "private": true
}
