{
  "name": "weblol",
  "version": "1.0.0",
  "description": "Painel do time: estatísticas do Worlds 2026, planejador de comps e draft, mapa tático e conhecimento (objetivos e controle de wave).",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/build-icons.mjs",
    "build": "tsc --noEmit && vite build",
