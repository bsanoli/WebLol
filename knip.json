{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/entrypoints/*.{ts,tsx}", "tests/**/*.ts", "scripts/**/*.mjs", "steiger.config.ts"],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["src/data/soloq/encounters.ts"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreIssues": {
    "src/shared/ui/**": ["files", "exports", "types", "duplicates"]
  },
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
